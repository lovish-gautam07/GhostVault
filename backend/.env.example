# ==============================================================================
# GhostVault Backend Environment Configuration
# ==============================================================================

# Server Environment
PORT=3001
NODE_ENV=development

# Database Connection
# SQLite (Default for local development and testing):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Required for production deployments on Render/Railway/Supabase/AWS):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/ghostvault?schema=public"

# Authentication & JWT Security
# CRITICAL: Generate a 32+ character high-entropy key for production (e.g. `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key_in_production
JWT_EXPIRES_IN=7d

# CORS and Origin Restrictions
# In production, set this to your exact frontend domain (e.g. https://vault.yourdomain.com)
FRONTEND_URL=http://localhost:3000

# Outbound Email (SMTP Configuration)
# In development, empty credentials automatically use Ethereal ephemeral test mail
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_production_sendgrid_or_resend_api_key

# Email Sender Identity
EMAIL_FROM="GhostVault Security <noreply@yourdomain.com>"

# Dead Man's Switch Cron Schedules (Standard 5-field cron syntax)
# Daily check-in reminder notification schedule (Default: Daily at 9:00 AM)
CHECKIN_CRON_SCHEDULE="0 9 * * *"

# Inactivity verification & emergency release dispatch schedule (Default: Daily at 12:00 AM)
INACTIVITY_CRON_SCHEDULE="0 0 * * *"
